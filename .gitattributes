# ============================================================
# MU MBA Course Recommendations — .gitattributes
# ============================================================

# Default: normalize to LF on commit
* text=auto eol=lf

# Source code
*.py     text eol=lf diff=python
*.sh     text eol=lf
*.bash   text eol=lf
*.html   text eol=lf diff=html
*.css    text eol=lf
*.scss   text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.tex    text eol=lf
*.bib    text eol=lf
*.xml    text eol=lf

# Scripts must keep LF even on Windows
*.sh     text eol=lf
*.bash   text eol=lf

# Binary files: do not normalize
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.svg    text eol=lf
*.ico    binary
*.webp   binary
*.pdf    binary
*.docx   binary
*.doc    binary
*.zip    binary
*.tar.gz binary

# LaTeX auxiliary files should not appear in diffs
*.aux    -diff
*.log    -diff
*.toc    -diff

# Linguist overrides — keep the language breakdown meaningful
docs/*.html linguist-documentation
*.md         linguist-documentation
*.tex        linguist-documentation
assets/*     linguist-documentation