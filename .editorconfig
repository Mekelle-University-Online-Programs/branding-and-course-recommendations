# ============================================================
# MU MBA Course Recommendations — .editorconfig
# https://editorconfig.org
# ============================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{tex,cls,sty}]
indent_size = 2
max_line_length = off

[Makefile]
indent_style = tab

[*.{py}]
indent_size = 4
max_line_length = 88

[*.{html,css,scss,js,json,yml,yaml}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2