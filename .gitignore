# ============================================================
# MU MBA Course Recommendations — .gitignore
# ============================================================

# ---------- LaTeX build artifacts ----------
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv
*.bcf
*-blx.bib
.latexmkrc
*.upa
*.upb

# ---------- Pandoc / Word temporary files ----------
*.docx~
*.doc~
~$*.docx
~$*.doc
*.tmp.docx
*.bak.docx
.docx.bak

# ---------- Office lock files ----------
.~lock.*
~$*

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/

# ---------- Node (if tooling is added later) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm

# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
Icon?
.DocumentRevisions-V100

# ---------- Windows ----------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------- Linux ----------
*~
.directory
.Trash-*

# ---------- IDE / editor ----------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ---------- Project-specific: local drafts ----------
# Keep local working files out of the repo
.local/
drafts/
!docs/latex/drafts/.gitkeep

# ---------- Project-specific: source course exports ----------
# Do not commit the raw Open edX Studio export.
# Only the derived analysis and recommendations belong here.
course-exports/
*.tar.gz
*.tgz
*.zip
!assets/templates/*.zip

# ---------- Project-specific: sensitive data ----------
# Never commit these
secrets/
.env
.env.*
!.env.example
*.pem
*.key
*.crt
credentials.json
service-account*.json

# ---------- Project-specific: generated PDFs ----------
# Keep source files tracked, but not regenerated PDFs.
# Approved, signed PDFs under docs/approvals/ ARE tracked.
*.pdf
!docs/approvals/*.pdf
!docs/reference/*.pdf

# ---------- Project-specific: generated Word files ----------
# The canonical source is docs/branding-form.md
# The generated .docx is built by CI and released as an artifact.
docs/branding-form.docx
docs/branding-form-fillable.docx

# ---------- Project-specific: local form submissions ----------
# Respondent files, before they are approved and archived
inbox/
submissions/

# ---------- Project-specific: scratch and notes ----------
scratch/
notes-private/
TODO.local.md
*.local.md

# ---------- Coverage and profiling ----------
*.prof
*.lprof